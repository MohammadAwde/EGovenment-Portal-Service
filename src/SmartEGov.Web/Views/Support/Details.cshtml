@using System.Security.Claims
@model SmartEGov.Domain.Entities.SupportMessage
@{
    ViewData["Title"] = Model.Subject;
}

<div class="lb-page-header">
    <h2><i class="bi bi-chat-dots me-2"></i>@Model.Subject</h2>
    <a asp-action="Index" class="btn btn-lb-outline btn-sm"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <p class="mb-2">@Model.Message</p>

        @foreach (var r in Model.Replies.OrderBy(x => x.CreatedAt))
        {
            <div class="border-start border-3 ps-3 mb-2" style="border-color:@(r.IsFromAdmin ? "var(--lb-green)" : "#999") !important;">
                <div class="fw-semibold small" style="color:@(r.IsFromAdmin ? "var(--lb-green)" : "#666");">@r.SenderName</div>
                <div class="small text-muted">@r.Text</div>
            </div>
        }

        <form asp-action="AddReply" method="post" class="d-flex gap-2 mt-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="messageId" value="@Model.Id" />
            <input type="text" name="text" class="form-control form-control-sm" placeholder="Reply..." required />
            <button type="submit" class="btn btn-sm btn-outline-success">Send</button>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>
<script>
    const connection = new signalR.HubConnectionBuilder().withUrl("/supportHub").build();
    connection.on("ReceiveReply", function (messageId, reply) { location.reload(); });
    connection.start().then(function () {
        connection.invoke("JoinGroup", "@User.FindFirstValue(System.Security.Claims.ClaimTypes.NameIdentifier)");
    });
</script>