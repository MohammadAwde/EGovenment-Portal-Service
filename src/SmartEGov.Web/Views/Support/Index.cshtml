@model IEnumerable<SmartEGov.Domain.Entities.SupportMessage>
@{
    ViewData["Title"] = "Ask a Question";
}

<div class="lb-page-header">
    <h2><i class="bi bi-chat-dots me-2"></i>Ask a Question</h2>
    <p>Send a message to our team and get a reply here.</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="lb-form-card mb-4">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label class="form-label">Subject</label>
            <input type="text" name="subject" class="form-control" placeholder="e.g. Delay on my passport request" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Message</label>
            <textarea name="message" class="form-control" rows="3" placeholder="Type your question..." required></textarea>
        </div>
        <button type="submit" class="btn btn-lb-primary">
            <i class="bi bi-send me-1"></i>Send
        </button>
    </form>
</div>

<h5 class="mb-3">Your messages</h5>

@if (!Model.Any())
{
    <p class="text-muted">You haven't sent any messages yet.</p>
}
else
{
    <div class="list-group">
        @foreach (var m in Model)
        {
            <a asp-action="Details" asp-route-id="@m.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                <div>
                    <span class="fw-semibold">@m.Subject</span>
                    <small class="text-muted d-block">@m.CreatedAt.ToString("dd MMM yyyy")</small>
                </div>
                <span class="badge @(m.Status == "Answered" ? "bg-primary" : "bg-secondary")">@m.Status</span>
            </a>
        }
    </div>
    }
}

<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>
<script>
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/supportHub")
        .build();

    connection.on("ReceiveReply", function (messageId, reply) {
        location.reload();
    });

    connection.start().then(function () {
        connection.invoke("JoinGroup", "@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value");
    });
</script>