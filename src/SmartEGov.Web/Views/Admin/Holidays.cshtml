@model IEnumerable<SmartEGov.Domain.Entities.PublicHoliday>
@{
    ViewData["Title"] = "Holiday Management";
}

<div class="lb-page-header d-flex justify-content-between align-items-center">
    <div>
        <h2><i class="bi bi-calendar-x me-2"></i>Holiday Management</h2>
        <p>Manage Lebanese public holidays — these dates will be blocked for appointments.</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <!-- Add Holiday Form -->
    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white fw-semibold">
                <i class="bi bi-plus-circle me-2"></i>Add Holiday
            </div>
            <div class="card-body">
                <form asp-action="AddHoliday" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Name (English)</label>
                        <input type="text" name="name" class="form-control"
                               placeholder="e.g. Independence Day" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Name (Arabic)</label>
                        <input type="text" name="nameAr" class="form-control"
                               placeholder="مثال: يوم الاستقلال" required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-4">
                            <label class="form-label">Day</label>
                            <input type="number" name="day" class="form-control"
                                   min="1" max="31" required placeholder="DD" />
                        </div>
                        <div class="col-4">
                            <label class="form-label">Month</label>
                            <select name="month" class="form-select" required>
                                <option value="">Month</option>
                                <option value="1">January</option>
                                <option value="2">February</option>
                                <option value="3">March</option>
                                <option value="4">April</option>
                                <option value="5">May</option>
                                <option value="6">June</option>
                                <option value="7">July</option>
                                <option value="8">August</option>
                                <option value="9">September</option>
                                <option value="10">October</option>
                                <option value="11">November</option>
                                <option value="12">December</option>
                            </select>
                        </div>
                        <div class="col-4">
                            <label class="form-label">Year</label>
                            <input type="number" name="year" class="form-control"
                                   min="2024" max="2030" placeholder="Optional" />
                        </div>
                    </div>
                    <small class="text-muted d-block mb-3">
                        Leave Year empty for recurring annual holidays.
                    </small>
                    <button type="submit" class="btn btn-success w-100">
                        <i class="bi bi-plus-circle me-1"></i>Add Holiday
                    </button>
                </form>

                <!-- Lebanese Holidays Quick Add -->
                <hr />
                <p class="small fw-semibold text-muted">Quick Add Lebanese Holidays:</p>
                <div class="d-grid gap-1">
                    @{
                        var lebHolidays = new[]
                        {
                                        new { name = "New Year's Day", nameAr = "رأس السنة", day = 1, month = 1 },
                                        new { name = "Armenian Christmas", nameAr = "عيد الميلاد الأرمني", day = 6, month = 1 },
                                        new { name = "Saint Maroun's Day", nameAr = "عيد مار مارون", day = 9, month = 2 },
                                        new { name = "Labour Day", nameAr = "عيد العمال", day = 1, month = 5 },
                                        new { name = "Martyr's Day", nameAr = "عيد الشهداء", day = 6, month = 5 },
                                        new { name = "Resistance & Liberation Day", nameAr = "عيد التحرير", day = 25, month = 5 },
                                        new { name = "Assumption Day", nameAr = "عيد انتقال السيدة العذراء", day = 15, month = 8 },
                                        new { name = "Independence Day", nameAr = "عيد الاستقلال", day = 22, month = 11 },
                                        new { name = "Christmas Day", nameAr = "عيد الميلاد", day = 25, month = 12 },
                                        };
                    }
                    @foreach (var h in lebHolidays)
                    {
                        <form asp-action="AddHoliday" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="name" value="@h.name" />
                            <input type="hidden" name="nameAr" value="@h.nameAr" />
                            <input type="hidden" name="day" value="@h.day" />
                            <input type="hidden" name="month" value="@h.month" />
                            <button type="submit" class="btn btn-outline-success btn-sm w-100 text-start">
                                <i class="bi bi-plus me-1"></i>@h.name (@h.day/@h.month)
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Holidays List -->
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white fw-semibold">
                <i class="bi bi-calendar-check me-2"></i>Public Holidays (@Model.Count())
            </div>
            <div class="card-body p-0">
                @if (!Model.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-calendar-x fs-1"></i>
                        <p class="mt-2">No holidays added yet.</p>
                    </div>
                }
                else
                {
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Holiday</th>
                                <th>Arabic Name</th>
                                <th>Date</th>
                                <th>Recurring</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var h in Model)
                            {
                                <tr class="@(h.IsActive ? "" : "table-secondary opacity-50")">
                                    <td class="fw-semibold">@h.Name</td>
                                    <td>@h.NameAr</td>
                                    <td>
                                        @h.Day / @h.Month
                                        @if (h.Year.HasValue)
                                        {
                                            <span class="text-muted">/ @h.Year</span>
                                        }
                                    </td>
                                    <td>
                                        @if (h.Year == null)
                                        {
                                            <span class="badge bg-success">Every Year</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">@h.Year Only</span>
                                        }
                                    </td>
                                    <td>
                                        @if (h.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex gap-1">
                                            <form asp-action="ToggleHoliday" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@h.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-warning"
                                                        title="@(h.IsActive ? "Deactivate" : "Activate")">
                                                    <i class="bi bi-@(h.IsActive ? "pause" : "play")"></i>
                                                </button>
                                            </form>
                                            <form asp-action="DeleteHoliday" method="post" class="d-inline"
                                                  onsubmit="return confirm('Delete this holiday?')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@h.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>
