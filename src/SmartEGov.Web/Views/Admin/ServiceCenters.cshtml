@model IEnumerable<SmartEGov.Domain.Entities.ServiceCenter>
@{
    ViewData["Title"] = "Service Centers";
}

<div class="lb-page-header">
    <h2><i class="bi bi-geo-alt me-2"></i>Service Centers</h2>
</div>

<table class="table table-hover">
    <thead>
        <tr><th>Center</th><th>Working Hours</th><th>Lunch Break</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.CenterName<br /><small class="text-muted">@c.Address</small></td>
                <td>@c.WorkingHoursStart.ToString(@"hh\:mm") - @c.WorkingHoursEnd.ToString(@"hh\:mm")</td>
                <td>@c.LunchBreakStart.ToString(@"hh\:mm") - @c.LunchBreakEnd.ToString(@"hh\:mm")</td>
                <td><a asp-action="EditCenter" asp-route-id="@c.Id" class="btn btn-sm btn-outline-success">Edit</a></td>
            </tr>
        }
    </tbody>
</table>