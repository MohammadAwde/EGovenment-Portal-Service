@model SmartEGov.Domain.Entities.ServiceCenter
@{
    ViewData["Title"] = "Edit Hours";
    var dayNames = new Dictionary<DayOfWeek, string>
    {
        { DayOfWeek.Monday, "Monday" }, { DayOfWeek.Tuesday, "Tuesday" },
        { DayOfWeek.Wednesday, "Wednesday" }, { DayOfWeek.Thursday, "Thursday" },
        { DayOfWeek.Friday, "Friday" }
    };
}

<div class="lb-page-header">
    <h2><i class="bi bi-clock me-2"></i>Edit Hours — @Model.CenterName</h2>
</div>

<div class="lb-form-card">
    <form asp-action="EditCenter" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CenterName" />
        <input type="hidden" asp-for="Department" />
        <input type="hidden" asp-for="Address" />
        <input type="hidden" asp-for="Latitude" />
        <input type="hidden" asp-for="Longitude" />
        <input type="hidden" asp-for="WorkingHours" />
        <input type="hidden" asp-for="PhoneNumber" />
        <input type="hidden" asp-for="IsActive" />
        <input type="hidden" asp-for="WorkingHoursStart" />
        <input type="hidden" asp-for="WorkingHoursEnd" />
        <input type="hidden" asp-for="LunchBreakStart" />
        <input type="hidden" asp-for="LunchBreakEnd" />

        <div class="row mb-3">
            <div class="col-md-4 mb-3 form-check">
                <input asp-for="WorksOnSaturday" class="form-check-input" type="checkbox" />
                <label asp-for="WorksOnSaturday" class="form-check-label">Open on Saturday</label>
            </div>
            <div class="col-md-4 mb-3 form-check">
                <input asp-for="WorksOnSunday" class="form-check-input" type="checkbox" />
                <label asp-for="WorksOnSunday" class="form-check-label">Open on Sunday</label>
            </div>
        </div>

        <p class="text-muted small">Weekday hours (Saturday and Sunday use the checkboxes above; no separate hours for them).</p>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Day</th>
                        <th>Opens</th>
                        <th>Closes</th>
                        <th>Break starts</th>
                        <th>Break ends</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.DaySchedules.Count; i++)
                    {
                        var s = Model.DaySchedules.ElementAt(i);
                        <tr>
                            <td class="fw-semibold">@dayNames[s.DayOfWeek]</td>
                            <td>
                                <input type="hidden" name="daySchedules[@i].Id" value="@s.Id" />
                                <input type="hidden" name="daySchedules[@i].ServiceCenterId" value="@s.ServiceCenterId" />
                                <input type="hidden" name="daySchedules[@i].DayOfWeek" value="@((int)s.DayOfWeek)" />
                                <input type="time" name="daySchedules[@i].OpenTime" value="@s.OpenTime.ToString(@"hh\:mm")" class="form-control form-control-sm" />
                            </td>
                            <td><input type="time" name="daySchedules[@i].CloseTime" value="@s.CloseTime.ToString(@"hh\:mm")" class="form-control form-control-sm" /></td>
                            <td><input type="time" name="daySchedules[@i].BreakStart" value="@s.BreakStart.ToString(@"hh\:mm")" class="form-control form-control-sm" /></td>
                            <td><input type="time" name="daySchedules[@i].BreakEnd" value="@s.BreakEnd.ToString(@"hh\:mm")" class="form-control form-control-sm" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <button type="submit" class="btn btn-lb-primary mt-2">Save</button>
    </form>
</div>