@model GovernmentServiceDto
@{
    ViewData["Title"] = "Edit Government Service";
    var workflows = ViewBag.Workflows as IEnumerable<SmartEGov.Domain.Entities.ApprovalWorkflow> ?? Enumerable.Empty<SmartEGov.Domain.Entities.ApprovalWorkflow>();
    var requirements = ViewBag.RequiredDocuments as IEnumerable<SmartEGov.Application.DTOs.RequiredDocumentDto> ?? Enumerable.Empty<SmartEGov.Application.DTOs.RequiredDocumentDto>();
}

<div class="lb-page-header">
    <h2><i class="bi bi-pencil-square me-2"></i>Edit Government Service</h2>
    <p>Update the configuration for this government service.</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="lb-form-card">
            <form asp-action="EditService" method="post">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Category" class="form-label"></label>
                        <input asp-for="Category" class="form-control" />
                        <span asp-validation-for="Category" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Fee" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-currency-dollar"></i></span>
                            <input asp-for="Fee" class="form-control" type="number" step="0.01" />
                        </div>
                        <span asp-validation-for="Fee" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="EstimatedDays" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-calendar3"></i></span>
                            <input asp-for="EstimatedDays" class="form-control" type="number" />
                        </div>
                        <span asp-validation-for="EstimatedDays" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="SlotDurationMinutes" class="form-label">Appointment Duration (minutes)</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-hourglass-split"></i></span>
                            <input asp-for="SlotDurationMinutes" class="form-control" type="number" step="15" />
                        </div>
                        <span asp-validation-for="SlotDurationMinutes" class="text-danger small"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="ApprovalWorkflowId" class="form-label">Approval Workflow</label>
                    <select asp-for="ApprovalWorkflowId" class="form-select">
                        <option value="">-- No Workflow --</option>
                        @foreach (var wf in workflows)
                        {
                            <option value="@wf.Id">@wf.Name (@wf.TotalSteps steps)</option>
                        }
                    </select>
                </div>
                <div class="mb-4 form-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>

                <hr class="my-4" />

                <h5 class="text-uppercase fw-bold mb-3" style="color: var(--lb-green-dark); letter-spacing: .04em;">
                    <i class="bi bi-file-earmark-text me-2"></i>Required Documents
                </h5>

                <p class="text-muted small mb-3">
                    <i class="bi bi-info-circle me-1"></i>Manage documents that citizens must upload to submit a request for this service. 
                    Mark as <strong>Mandatory</strong> if required, or <strong>Optional</strong> if it's optional.
                </p>

                <div id="requirementsContainer" class="mb-3">
                    @{ var reqList = requirements.ToList(); var index = 0; var totalReq = reqList.Count; var mandatoryCount = reqList.Count(r => r.IsMandatory); }

                    <div class="mb-2 small">
                        <strong>Summary:</strong>
                        <span class="badge bg-secondary ms-2">Total: @totalReq</span>
                        <span class="badge bg-danger ms-1">Mandatory: @mandatoryCount</span>
                        <span class="badge bg-info ms-1">Optional: @(totalReq - mandatoryCount)</span>
                    </div>

                    @foreach (var req in reqList)
                    {
                        <div class="requirement-item mb-3 p-3 border rounded-2" style="background: #f8f9fa;">
                            <div class="row g-2">
                                <input type="hidden" name="requirements[@index].Id" value="@req.Id" />
                                <div class="col-md-4">
                                    <div class="d-flex align-items-center">
                                        <input type="text"
                                               name="requirements[@index].DocumentName"
                                               class="form-control me-2"
                                               value="@req.DocumentName"
                                               placeholder="Document name" />
                                        @if (req.IsMandatory)
                                        {
                                            <span class="badge bg-danger">Required</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Optional</span>
                                        }
                                    </div>
                                </div>
                                <div class="col-md-5">
                                    <input type="text"
                                           name="requirements[@index].Description"
                                           class="form-control"
                                           value="@(req.Description ?? "")"
                                           placeholder="Optional description" />
                                </div>
                                <div class="col-md-2">
                                    <div class="form-check mt-1">
                                        <input type="checkbox"
                                               name="requirements[@index].IsMandatory"
                                               value="true"
                                               class="form-check-input"
                                               @(req.IsMandatory ? "checked" : "") />
                                        <label class="form-check-label small">Mandatory</label>
                                    </div>
                                </div>
                                <div class="col-md-1">
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeRequirement(this)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        index++;
                    }
                </div>

                <button type="button" class="btn btn-sm btn-outline-primary mb-4" id="addRequirementBtn">
                    <i class="bi bi-plus-circle me-1"></i>Add Document
                </button>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-lb-primary">
                        <i class="bi bi-check-lg me-1"></i>Save Changes
                    </button>
                    <a asp-action="GovernmentServices" class="btn btn-outline-secondary">
                        <i class="bi bi-x-lg me-1"></i>Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let requirementCount = @(requirements.Count());

        document.getElementById('addRequirementBtn').addEventListener('click', function () {
            const container = document.getElementById('requirementsContainer');
            const newRequirement = document.createElement('div');
            newRequirement.className = 'requirement-item mb-3 p-3 border rounded-2';
            newRequirement.style.background = '#f8f9fa';
            newRequirement.innerHTML = `
                <div class="row g-2">
                    <input type="hidden" name="requirements[${requirementCount}].Id" value="0" />

                    <div class="col-md-4">
                        <input type="text" 
                               name="requirements[${requirementCount}].DocumentName" 
                               class="form-control" 
                               placeholder="Document name" />
                    </div>

                    <div class="col-md-5">
                        <input type="text" 
                               name="requirements[${requirementCount}].Description" 
                               class="form-control" 
                               placeholder="Optional description" />
                    </div>

                    <div class="col-md-2">
                        <div class="form-check mt-1">
                            <input type="checkbox" 
                                   name="requirements[${requirementCount}].IsMandatory" 
                                   value="true" 
                                   class="form-check-input" 
                                   checked />
                            <label class="form-check-label small">Mandatory</label>
                        </div>
                    </div>

                    <div class="col-md-1">
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeRequirement(this)">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
            `;
            container.appendChild(newRequirement);
            requirementCount++;
        });

        function removeRequirement(btn) {
            btn.closest('.requirement-item').remove();
        }

        // If navigated with fragment to requirementsContainer, smooth scroll and highlight
        (function(){
            try {
                if (window.location.hash === '#requirementsContainer') {
                    var el = document.getElementById('requirementsContainer');
                    if (el) {
                        el.scrollIntoView({ behavior: 'smooth', block: 'start' });
                        el.style.transition = 'box-shadow 0.3s ease, border 0.3s ease';
                        el.style.boxShadow = '0 0 0 4px rgba(16, 185, 129, 0.12)';
                        el.style.border = '1px solid rgba(16,185,129,0.6)';
                        setTimeout(function(){ el.style.boxShadow = ''; el.style.border = ''; }, 3000);
                        // focus first input
                        var first = el.querySelector('input[name$=".DocumentName"]');
                        if (first) first.focus();
                    }
                }
            } catch (e) { /* ignore */ }
        })();
    </script>
}
