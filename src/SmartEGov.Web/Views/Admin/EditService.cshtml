@model GovernmentServiceDto
@{
    ViewData["Title"] = "Edit Government Service";
    var workflows = ViewBag.Workflows as IEnumerable<SmartEGov.Domain.Entities.ApprovalWorkflow> ?? Enumerable.Empty<SmartEGov.Domain.Entities.ApprovalWorkflow>();
}

<div class="lb-page-header">
    <h2><i class="bi bi-pencil-square me-2"></i>Edit Government Service</h2>
    <p>Update the configuration for this government service.</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="lb-form-card">
            <form asp-action="EditService" method="post">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Category" class="form-label"></label>
                        <input asp-for="Category" class="form-control" />
                        <span asp-validation-for="Category" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Fee" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-currency-dollar"></i></span>
                            <input asp-for="Fee" class="form-control" type="number" step="0.01" />
                        </div>
                        <span asp-validation-for="Fee" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="EstimatedDays" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-calendar3"></i></span>
                            <input asp-for="EstimatedDays" class="form-control" type="number" />
                        </div>
                        <span asp-validation-for="EstimatedDays" class="text-danger small"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="ApprovalWorkflowId" class="form-label">Approval Workflow</label>
                    <select asp-for="ApprovalWorkflowId" class="form-select">
                        <option value="">-- No Workflow --</option>
                        @foreach (var wf in workflows)
                        {
                            <option value="@wf.Id">@wf.Name (@wf.TotalSteps steps)</option>
                        }
                    </select>
                </div>
                <div class="mb-4 form-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-lb-primary">
                        <i class="bi bi-check-lg me-1"></i>Save Changes
                    </button>
                    <a asp-action="GovernmentServices" class="btn btn-outline-secondary">
                        <i class="bi bi-x-lg me-1"></i>Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
