@model IEnumerable<SmartEGov.Application.DTOs.AppointmentDto>
@{
    ViewData["Title"] = "Appointments";
}

<div class="d-flex justify-content-between align-items-center mb-1">
    <h2 class="mb-0" style="color:var(--lb-green-dark);">
        <i class="bi bi-calendar-check me-2"></i>Appointments
    </h2>
    <a asp-action="ExportAppointmentsCsv" class="btn btn-outline-success btn-sm">
        <i class="bi bi-download me-1"></i>Export to CSV
    </a>
</div>
<hr />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Stats row -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card text-center border-success">
            <div class="card-body py-3">
                <div class="fs-3 fw-bold text-success">@Model.Count(a => a.Status == "Booked")</div>
                <div class="small text-muted">Booked</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center border-primary">
            <div class="card-body py-3">
                <div class="fs-3 fw-bold text-primary">@Model.Count(a => a.Status == "Completed")</div>
                <div class="small text-muted">Completed</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center border-danger">
            <div class="card-body py-3">
                <div class="fs-3 fw-bold text-danger">@Model.Count(a => a.Status == "Cancelled")</div>
                <div class="small text-muted">Cancelled</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center border-warning">
            <div class="card-body py-3">
                <div class="fs-3 fw-bold text-warning">@Model.Count(a => a.Status == "No-Show")</div>
                <div class="small text-muted">No-Show</div>
            </div>
        </div>
    </div>
</div>

<!-- Filter bar -->
<div class="card shadow-sm mb-3">
    <div class="card-body py-2">
        <div class="d-flex gap-2 flex-wrap">
            <input type="text" id="searchInput" class="form-control form-control-sm" style="max-width:250px;"
                   placeholder="Search by name, reference, center…" />
            <select id="statusFilter" class="form-select form-select-sm" style="max-width:160px;">
                <option value="">All Statuses</option>
                <option value="Booked">Booked</option>
                <option value="Completed">Completed</option>
                <option value="Cancelled">Cancelled</option>
                <option value="No-Show">No-Show</option>
            </select>
            <input type="date" id="dateFilter" class="form-control form-control-sm" style="max-width:170px;" />
            <button class="btn btn-sm btn-outline-secondary" onclick="clearFilters()">Clear</button>
        </div>
    </div>
</div>

<!-- Table -->
@if (!Model.Any())
{
    <div class="card text-center py-5">
        <div class="card-body">
            <i class="bi bi-calendar-x fs-1 text-muted"></i>
            <p class="mt-3 text-muted">No appointments found.</p>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0" id="appointmentsTable">
                <thead class="table-light">
                    <tr>
                        <th>Reference</th>
                        <th>Citizen</th>
                        <th>Service Center</th>
                        <th>Service</th>
                        <th>Date</th>
                        <th>Slot</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        <tr class="appt-row"
                            data-status="@a.Status"
                            data-date="@a.AppointmentDate.ToString("yyyy-MM-dd")"
                            data-search="@(a.ReferenceNumber + " " + a.ServiceCenterName + " " + a.GovernmentServiceName)">
                            <td><code>@a.ReferenceNumber</code></td>
                            <td>@(a.CitizenName ?? a.UserId)</td>
                            <td>
                                @a.ServiceCenterName
                                <small class="d-block text-muted">@a.ServiceCenterAddress</small>
                            </td>
                            <td>@a.GovernmentServiceName</td>
                            <td>@a.AppointmentDate.ToString("dd MMM yyyy")</td>
                            <td><span class="badge bg-secondary">@a.TimeSlot</span></td>
                            <td>
                                @{
                                    var cls = a.Status switch
                                    {
                                        "Booked" => "bg-success",
                                        "Cancelled" => "bg-danger",
                                        "Completed" => "bg-primary",
                                        "No-Show" => "bg-warning text-dark",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @cls">@a.Status</span>
                            </td>
                            <td>
                                @if (a.Status == "Booked")
                                {
                                    <form asp-controller="Admin" asp-action="MarkAppointmentCompleted"
                                          asp-route-id="@a.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-primary me-1"
                                                title="Mark as Completed">
                                            <i class="bi bi-check-circle"></i>
                                        </button>
                                    </form>
                                    <form asp-controller="Admin" asp-action="MarkAppointmentNoShow"
                                          asp-route-id="@a.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-warning"
                                                title="Mark as No-Show">
                                            <i class="bi bi-person-x"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="text-muted small mt-2">Total: <span id="visibleCount">@Model.Count()</span> appointments</div>
}

@section Scripts {
    <script>
        const searchInput  = document.getElementById('searchInput');
        const statusFilter = document.getElementById('statusFilter');
        const dateFilter   = document.getElementById('dateFilter');

        function filterTable() {
            const search = searchInput.value.toLowerCase();
            const status = statusFilter.value;
            const date   = dateFilter.value;
            let count = 0;

            document.querySelectorAll('.appt-row').forEach(row => {
                const matchSearch = !search || row.dataset.search.toLowerCase().includes(search);
                const matchStatus = !status || row.dataset.status === status;
                const matchDate   = !date   || row.dataset.date === date;
                const show = matchSearch && matchStatus && matchDate;
                row.style.display = show ? '' : 'none';
                if (show) count++;
            });

            const counter = document.getElementById('visibleCount');
            if (counter) counter.textContent = count;
        }

        function clearFilters() {
            searchInput.value = '';
            statusFilter.value = '';
            dateFilter.value = '';
            filterTable();
        }

        searchInput.addEventListener('input', filterTable);
        statusFilter.addEventListener('change', filterTable);
        dateFilter.addEventListener('change', filterTable);
    </script>
}
