@model IEnumerable<SmartEGov.Application.DTOs.AppointmentDto>
@{
    ViewData["Title"] = "Appointments";
}

<div class="d-flex justify-content-between align-items-center mb-1">
    <h2 class="mb-0" style="color:var(--lb-green-dark);">
        <i class="bi bi-calendar-check me-2"></i>Appointments
    </h2>
</div>
<hr />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="card text-center py-5">
        <div class="card-body">
            <i class="bi bi-calendar-x fs-1 text-muted"></i>
            <p class="mt-3 text-muted">No appointments found.</p>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Reference</th>
                        <th>Citizen</th>
                        <th>Service Center</th>
                        <th>Service</th>
                        <th>Date</th>
                        <th>Slot</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td><code>@a.ReferenceNumber</code></td>
                            <td>@(a.CitizenName ?? a.UserId)</td>
                            <td>
                                @a.ServiceCenterName
                                <small class="d-block text-muted">@a.ServiceCenterAddress</small>
                            </td>
                            <td>@a.GovernmentServiceName</td>
                            <td>@a.AppointmentDate.ToString("dd MMM yyyy")</td>
                            <td><span class="badge bg-secondary">@a.TimeSlot</span></td>
                            <td>
                                @{
                                    var cls = a.Status switch
                                    {
                                        "Booked" => "bg-success",
                                        "Cancelled" => "bg-danger",
                                        "Completed" => "bg-primary",
                                        "No-Show" => "bg-warning text-dark",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @cls">@a.Status</span>
                            </td>
                            <td>
                                @if (a.Status == "Booked")
                                {
                                    <form asp-controller="Officer" asp-action="MarkAppointmentCompleted"
                                          asp-route-id="@a.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-primary me-1"
                                                title="Mark as Completed">
                                            <i class="bi bi-check-circle"></i>
                                        </button>
                                    </form>
                                    <form asp-controller="Officer" asp-action="MarkAppointmentNoShow"
                                          asp-route-id="@a.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-warning"
                                                title="Mark as No-Show">
                                            <i class="bi bi-person-x"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}