@model IEnumerable<SmartEGov.Domain.Entities.SupportMessage>
@{
    ViewData["Title"] = "Support Messages";
}

<div class="lb-page-header">
    <h2><i class="bi bi-chat-dots me-2"></i>Support Messages</h2>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="list-group">
    @foreach (var m in Model)
    {
        <a asp-action="MessageDetails" asp-route-id="@m.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
            <div>
                <span class="fw-semibold">@m.Subject</span>
                <small class="text-muted d-block">@m.CitizenName — @m.CreatedAt.ToString("dd MMM yyyy")</small>
            </div>
            <span class="badge @(m.Status == "Answered" ? "bg-primary" : "bg-warning text-dark")">@m.Status</span>
        </a>
    }
</div>