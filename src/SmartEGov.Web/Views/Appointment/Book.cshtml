@model SmartEGov.Application.DTOs.BookAppointmentRequest
@{
    ViewData["Title"] = "Book Appointment";
    var centers = ViewBag.Centers as IEnumerable<SmartEGov.Application.DTOs.ServiceCenterDto> ?? [];
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="container-fluid py-4">
    <h2 class="mb-4"><i class="bi bi-calendar-plus me-2"></i>Book an Appointment</h2>

    <form asp-action="Book" method="post" id="bookingForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="row g-4">
            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-success text-white fw-semibold">
                        <i class="bi bi-geo-alt me-2"></i>Step 1 — Find a Service Center
                    </div>
                    <div class="card-body p-0 d-flex flex-column">

                        <!-- Leaflet Map -->
                        <div id="map" style="height:280px;width:100%;"></div>

                        <!-- Location button -->
                        <div class="p-3 border-bottom">
                            <button type="button" class="btn btn-outline-success w-100" id="btnDetect">
                                <i class="bi bi-crosshair me-1"></i>Use My Location &amp; Find Nearest Centers
                            </button>
                            <div id="locationStatus" class="text-muted small mt-2"></div>
                        </div>

                        <!-- Center list -->
                        <div class="p-3" style="overflow-y:auto;max-height:260px;">
                            <label class="form-label fw-semibold mb-2">Select a Center</label>
                            <div id="centerList" class="list-group">
                                @foreach (var c in centers)
                                {
                                    <button type="button"
                                            class="list-group-item list-group-item-action center-item"
                                            data-id="@c.Id"
                                            data-lat="@c.Latitude"
                                            data-lng="@c.Longitude"
                                            data-name="@c.CenterName">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <strong>@c.CenterName</strong>
                                                <small class="d-block text-muted">@c.Address</small>
                                                <small class="text-muted">@c.WorkingHours</small>
                                            </div>
                                            <span class="badge bg-light text-dark ms-2 dist-badge flex-shrink-0"></span>
                                        </div>
                                    </button>
                                }
                            </div>
                        </div>

                        <input type="hidden" asp-for="ServiceCenterId" id="selectedCenter" />
                        <span asp-validation-for="ServiceCenterId" class="text-danger small px-3 pb-2"></span>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-success text-white fw-semibold">
                        <i class="bi bi-clock me-2"></i>Step 2 — Choose Date & Time
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Government Service</label>
                            <select asp-for="GovernmentServiceId" class="form-select" id="svcSelect">
                                <option value="">— Select a service —</option>
                                @foreach (var s in ViewBag.Services as IEnumerable<SmartEGov.Domain.Entities.GovernmentService> ?? [])
                                {
                                    <option value="@s.Id">@s.Name</option>
                                }
                            </select>
                            <span asp-validation-for="GovernmentServiceId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Appointment Date</label>
                            <input asp-for="AppointmentDate" type="date" id="apptDate" class="form-control"
                                   min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" />
                            <small class="text-muted">Appointments available Monday to Friday (Friday: morning only until 12:00). No appointments on weekends.</small>
                            <span asp-validation-for="AppointmentDate" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Available Slots</label>
                            <div id="slotGrid" class="d-flex flex-wrap gap-2">
                                <p class="text-muted small">Select a center and date first.</p>
                            </div>
                            <input type="hidden" asp-for="TimeSlot" id="selectedSlot" />
                            <span asp-validation-for="TimeSlot" class="text-danger small"></span>
                        </div>

                        <div id="summary" class="alert alert-info d-none mb-3">
                            <i class="bi bi-info-circle me-2"></i>
                            <span id="summaryText"></span>
                        </div>

                        <button type="submit" class="btn btn-success w-100" id="btnConfirm" disabled>
                            <i class="bi bi-check-circle me-2"></i>Confirm Appointment
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

@section Scripts {
    <script>
        // ── Map setup — centered on Lebanon ──────────────────────────────────────────
        const map = L.map('map').setView([33.8547, 35.8623], 8);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
            maxZoom: 18
        }).addTo(map);

        const centerIcon = L.icon({
            iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-blue.png',
            shadowUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png',
            iconSize: [25, 41], iconAnchor: [12, 41], popupAnchor: [1, -34], shadowSize: [41, 41]
        });

        const userIcon = L.icon({
            iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-red.png',
            shadowUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png',
            iconSize: [25, 41], iconAnchor: [12, 41], popupAnchor: [1, -34], shadowSize: [41, 41]
        });

        let selectedCenterId = null;
        let userMarker = null;
        const centerMarkers = {};

        // Build markers from server-rendered list
        document.querySelectorAll('.center-item').forEach(btn => {
            const id   = parseInt(btn.dataset.id);
            const lat  = parseFloat(btn.dataset.lat);
            const lng  = parseFloat(btn.dataset.lng);
            const name = btn.dataset.name;

            if (lat && lng) {
                const marker = L.marker([lat, lng], { icon: centerIcon })
                    .addTo(map)
                    .bindPopup(`<strong>${name}</strong>`);

                marker.on('click', () => {
                    selectCenter(id, btn);
                    marker.openPopup();
                });

                centerMarkers[id] = marker;
            }
        });

        // Fit map to all markers
        const allLatLngs = Object.values(centerMarkers).map(m => m.getLatLng());
        if (allLatLngs.length) map.fitBounds(L.latLngBounds(allLatLngs).pad(0.2));

        // ── Geolocation ───────────────────────────────────────────────────────────────
        document.getElementById('btnDetect').addEventListener('click', () => {
            const status = document.getElementById('locationStatus');
            status.innerHTML = '<div class="spinner-border spinner-border-sm me-1"></div> Detecting location…';

            if (!navigator.geolocation) {
                status.textContent = 'Geolocation is not supported by your browser.';
                return;
            }

            navigator.geolocation.getCurrentPosition(
                pos => {
                    const { latitude: lat, longitude: lng } = pos.coords;
                    status.textContent = `📍 Location found (${lat.toFixed(4)}, ${lng.toFixed(4)})`;

                    if (userMarker) map.removeLayer(userMarker);
                    userMarker = L.marker([lat, lng], { icon: userIcon })
                        .addTo(map)
                        .bindPopup('<strong>Your Location</strong>')
                        .openPopup();

                    map.setView([lat, lng], 11);
                    loadNearestCenters(lat, lng);
                },
                err => {
                    const msgs = {
                        1: 'Location permission denied. Please allow location access in your browser.',
                        2: 'Location unavailable. Check your device settings.',
                        3: 'Location request timed out. Please try again.'
                    };
                    status.textContent = msgs[err.code] || 'Could not get your location.';
                },
                { timeout: 10000, enableHighAccuracy: true }
            );
        });

        async function loadNearestCenters(lat, lng) {
            const res = await fetch(`/Appointment/GetNearestCenters?lat=${lat}&lng=${lng}&radiusKm=100`);
            const centers = await res.json();
            const list = document.getElementById('centerList');
            list.innerHTML = '';

            if (!centers.length) {
                list.innerHTML = '<p class="text-muted small p-2">No service centers found nearby.</p>';
                return;
            }

            centers.forEach(c => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'list-group-item list-group-item-action center-item';
                btn.dataset.id   = c.id;
                btn.dataset.lat  = c.latitude;
                btn.dataset.lng  = c.longitude;
                btn.dataset.name = c.centerName;

                const km = c.distanceKm != null ? `${c.distanceKm.toFixed(1)} km` : '';
                btn.innerHTML = `
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <strong>${c.centerName}</strong>
                            <small class="d-block text-muted">${c.address}</small>
                            <small class="text-muted">${c.workingHours}</small>
                        </div>
                        <span class="badge bg-primary ms-2 flex-shrink-0">${km}</span>
                    </div>`;

                btn.addEventListener('click', () => selectCenter(c.id, btn));
                list.appendChild(btn);

                if (centerMarkers[c.id]) {
                    centerMarkers[c.id].bindPopup(`<strong>${c.centerName}</strong><br>${km} away`);
                }
            });

            // Draw dashed lines from user to nearest 5 centers
            centers.slice(0, 5).forEach(c => {
                if (c.latitude && c.longitude) {
                    L.polyline([[lat, lng], [c.latitude, c.longitude]], {
                        color: '#0d6efd', weight: 1.5, opacity: 0.4, dashArray: '6,6'
                    }).addTo(map);
                }
            });
        }

        // ── Center selection ──────────────────────────────────────────────────────────
        document.getElementById('centerList').addEventListener('click', e => {
            const btn = e.target.closest('.center-item');
            if (btn) selectCenter(parseInt(btn.dataset.id), btn);
        });

        function selectCenter(id, el) {
            document.querySelectorAll('.center-item').forEach(b => b.classList.remove('active'));
            el.classList.add('active');
            selectedCenterId = id;
            document.getElementById('selectedCenter').value = id;

            if (centerMarkers[id]) {
                map.setView(centerMarkers[id].getLatLng(), 14);
                centerMarkers[id].openPopup();
            }

            loadSlots();
            checkReady();
        }

        // ── Slot loading ──────────────────────────────────────────────────────────────
                document.getElementById('apptDate').addEventListener('change', loadSlots);
        document.getElementById('svcSelect').addEventListener('change', loadSlots);

        async function loadSlots() {
            const date = document.getElementById('apptDate').value;
            const serviceId = document.getElementById('svcSelect').value;
            if (!selectedCenterId || !date) return;
            if (!serviceId) {
                document.getElementById('slotGrid').innerHTML =
                    '<p class="text-muted small">Please select a service first.</p>';
                return;
            }
            const dayOfWeek = new Date(date).getDay();
             if (dayOfWeek === 0 || dayOfWeek === 6) {
            document.getElementById('slotGrid').innerHTML =
                '<p class="text-warning small">No appointments on weekends. Please choose a weekday (Mon–Fri).</p>';
            return;
        }

            const grid = document.getElementById('slotGrid');
            grid.innerHTML = '<span class="text-muted small"><div class="spinner-border spinner-border-sm me-1"></div>Loading slots…</span>';
            document.getElementById('selectedSlot').value = '';
            checkReady();

            const slots = await (await fetch(`/Appointment/GetSlots?centerId=${selectedCenterId}&serviceId=${serviceId}&date=${date}`)).json();
            grid.innerHTML = '';

            if (!slots.length) {
                grid.innerHTML = '<p class="text-warning small">No slots available for this date. Try another day.</p>';
                return;
            }

            slots.forEach(slot => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'btn btn-outline-success btn-sm slot-btn';
                btn.textContent = slot;
                btn.addEventListener('click', () => pickSlot(slot, btn));
                grid.appendChild(btn);
            });
        }

        function pickSlot(slot, el) {
            document.querySelectorAll('.slot-btn').forEach(b => b.classList.remove('active', 'btn-success'));
            el.classList.add('active', 'btn-success');
            document.getElementById('selectedSlot').value = slot;
            const centerName = document.querySelector('.center-item.active strong')?.textContent ?? '—';
            const date = document.getElementById('apptDate').value;
            document.getElementById('summaryText').textContent = `${centerName} · ${date} · ${slot}`;
            document.getElementById('summary').classList.remove('d-none');
            checkReady();
        }

        document.getElementById('svcSelect').addEventListener('change', checkReady);

        function checkReady() {
            const ok = selectedCenterId
                && document.getElementById('apptDate').value
                && document.getElementById('selectedSlot').value
                && document.getElementById('svcSelect').value;
            document.getElementById('btnConfirm').disabled = !ok;
        }
    </script>
}
