@model IEnumerable<SmartEGov.Application.DTOs.AppointmentDto>
@{
    ViewData["Title"] = "My Appointments";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-calendar-check me-2"></i>My Appointments</h2>
        <a asp-action="Book" class="btn btn-success"><i class="bi bi-plus-circle me-1"></i>Book Appointment</a>
    </div>
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (!Model.Any())
    {
        <div class="card text-center py-5">
            <div class="card-body">
                <i class="bi bi-calendar-x fs-1 text-muted"></i>
                <p class="mt-3 text-muted">No appointments yet.</p>
                <a asp-action="Book" class="btn btn-success mt-2">Book Your First Appointment</a>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr><th>Reference</th><th>Service Center</th><th>Service</th><th>Date</th><th>Slot</th><th>Status</th><th>Actions</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model)
                        {
                            <tr>
                                <td><code>@a.ReferenceNumber</code></td>
                                <td>@a.ServiceCenterName<small class="d-block text-muted">@a.ServiceCenterAddress</small></td>
                                <td>@a.GovernmentServiceName</td>
                                <td>@a.AppointmentDate.ToString("dd MMM yyyy")</td>
                                <td><span class="badge bg-secondary">@a.TimeSlot</span></td>
                                <td>
                                    @{
                                        var cls = a.Status switch
                                        {
                                            "Booked" => "bg-success",
                                            "Cancelled" => "bg-danger",
                                            "Completed" => "bg-primary",
                                            "No-Show" => "bg-warning text-dark",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @cls">@a.Status</span>
                                </td>
                                <td>
                                    @if (a.Status == "Booked")
                                    {
                                        <a asp-action="Reschedule" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary me-1">
                                            <i class="bi bi-calendar-event"></i> Reschedule
                                        </a>
                                        <form asp-action="Cancel" asp-route-id="@a.Id" method="post" class="d-inline"
                                              onsubmit="return confirm('Cancel this appointment?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-x-circle"></i> Cancel</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
