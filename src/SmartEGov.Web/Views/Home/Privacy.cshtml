@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="lb-page-header">
    <h2><i class="bi bi-shield-lock me-2"></i>Privacy Policy</h2>
    <p>Learn how we handle and protect your personal information.</p>
</div>

<div class="lb-form-card">
    <div class="row">
        <div class="col-lg-8">
            <h5 style="color:var(--lb-green-dark);font-weight:700;">Data Protection</h5>
            <p class="text-muted">
                The Lebanese E-Government Portal is committed to protecting your privacy. All personal data collected
                through this portal is handled in accordance with applicable data protection laws and regulations.
            </p>
            <h5 class="mt-4" style="color:var(--lb-green-dark);font-weight:700;">Information We Collect</h5>
            <ul class="text-muted">
                <li>Personal identification details (name, national ID, date of birth)</li>
                <li>Contact information (phone number, email address)</li>
                <li>Service request data and uploaded documents</li>
                <li>Payment transaction records</li>
            </ul>
            <h5 class="mt-4" style="color:var(--lb-green-dark);font-weight:700;">How We Use Your Data</h5>
            <p class="text-muted">
                Your information is used exclusively for processing government service requests, maintaining audit trails,
                and improving our services. We do not share your data with unauthorized third parties.
            </p>
        </div>
        <div class="col-lg-4">
            <div class="lb-info-card">
                <h6><i class="bi bi-question-circle me-1"></i>Questions?</h6>
                <ul class="list-unstyled mb-0 small">
                    <li class="mb-2"><i class="bi bi-envelope text-primary me-1"></i> info@@egov.gov.lb</li>
                    <li class="mb-2"><i class="bi bi-telephone text-primary me-1"></i> Hotline: 1700</li>
                    <li><i class="bi bi-geo-alt text-primary me-1"></i> Beirut, Lebanon</li>
                </ul>
            </div>
        </div>
    </div>
</div>
