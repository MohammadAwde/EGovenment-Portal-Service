@model ServiceRequestDto
@{
    ViewData["Title"] = "Edit Service Request";
    var maxSizeMB = ViewBag.MaxFileSizeMB as int? ?? 10;
    var allowedExtensions = ViewBag.AllowedExtensions as string ?? "";
    var allowedExtensionsAccept = ViewBag.AllowedExtensionsAccept as string ?? "";
}

<div class="lb-page-header">
    <h2><i class="bi bi-pencil-square me-2"></i>Edit Service Request</h2>
    <p>Update details or save your request as a draft.</p>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="lb-form-card">
            <form asp-action="Edit" method="post" enctype="multipart/form-data" id="editServiceRequestForm" novalidate>
                <input asp-for="Id" type="hidden" />
                <div asp-validation-summary="All" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="GovernmentServiceId" class="form-label">Government Service</label>
                    <select asp-for="GovernmentServiceId" asp-items="@(ViewBag.Services as SelectList)" class="form-select" id="GovernmentServiceId">
                        <option value="">-- Select a Service --</option>
                    </select>
                    <span asp-validation-for="GovernmentServiceId" class="text-danger small"></span>
                </div>

                <div id="requirements-section" class="mb-3" style="display:none;">
                    <div class="card border-0" style="background:var(--lb-green-light);border-left:4px solid var(--lb-green)!important;">
                        <div class="card-header bg-transparent border-0" style="color:var(--lb-green-dark);font-weight:700;">
                            <i class="bi bi-file-earmark-text me-1"></i> Required Documents for this Service
                        </div>
                        <ul id="requirements-list" class="list-group list-group-flush">
                        </ul>
                        <div id="requirements-note" class="p-3 border-top small" style="background:rgba(0,98,51,.05);color:var(--lb-green-dark);">
                            <i class="bi bi-exclamation-circle me-1"></i>
                            <strong>Important:</strong> You must upload <span id="mandatory-count">0</span> mandatory document(s) to submit your request. 
                            Optional documents can be added later.
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Notes" class="form-label">Notes / Additional Information</label>
                    <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Any extra details for the reviewing officer..."></textarea>
                    <span asp-validation-for="Notes" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label"><i class="bi bi-paperclip me-1"></i>Attach Documents</label>
                    <div id="requirementStatus" class="alert alert-warning" style="display:none;">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        <strong id="statusMessage">Please upload all required documents</strong>
                        <div id="missingDocsList" class="mt-2 small"></div>
                    </div>
                    <input type="file" name="documents" id="fileInput" class="form-control" multiple accept="@allowedExtensionsAccept" />
                    <div class="form-text">
                        Max file size: @maxSizeMB MB. Allowed types: @allowedExtensions
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" name="saveAsDraft" value="true" class="btn btn-outline-secondary" id="saveDraftBtn">
                        <i class="bi bi-save me-1"></i>Save as Draft
                    </button>
                    <button type="submit" class="btn btn-lb-primary" id="submitBtn" disabled>
                        <i class="bi bi-send me-1"></i>Submit Request
                    </button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                        <i class="bi bi-x-lg me-1"></i>Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="lb-info-card">
            <h6><i class="bi bi-lightbulb me-1"></i>Tips</h6>
            <ul class="list-unstyled mb-0 small">
                <li class="mb-2"><i class="bi bi-check-circle text-success me-1"></i> You can save progress and complete later.</li>
                <li class="mb-2"><i class="bi bi-file-earmark-arrow-up text-primary me-1"></i> Upload <strong>all required documents</strong> before submission.</li>
                <li class="mb-2"><i class="bi bi-clock-history text-warning me-1"></i> Submitting will start the review workflow.</li>
                <li><i class="bi bi-bell text-info me-1"></i> Notifications are sent on status changes.</li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let requiredDocuments = [];
        let selectedFiles = [];

        const fileInput = document.getElementById('fileInput');
        const form = document.getElementById('editServiceRequestForm');

        fileInput.addEventListener('change', (e) => {
            const files = Array.from(e.target.files);
            selectedFiles = files;
            updateRequirementStatus();
        });

        function updateRequirementStatus() {
            if (requiredDocuments.length === 0) {
                document.getElementById('submitBtn').disabled = false;
                document.getElementById('requirementStatus').style.display = 'none';
                return;
            }

            const mandatoryDocs = requiredDocuments.filter(d => d.isMandatory);
            const missingDocs = [];

            mandatoryDocs.forEach(doc => {
                const docName = doc.documentName.toLowerCase();
                const docTokens = docName.replace(/\W+/g, ' ').split(' ').filter(t => t.length > 1);

                let hasDoc = false;

                selectedFiles.forEach(file => {
                    const fileName = file.name.toLowerCase();
                    const fileTokens = fileName.replace(/\W+/g, ' ').split(' ').filter(t => t.length > 1);

                    if (docTokens.some(dt => fileTokens.some(ft => dt === ft))) {
                        hasDoc = true;
                    }
                });

                if (!hasDoc) {
                    missingDocs.push(doc.documentName);
                }
            });

            const statusDiv = document.getElementById('requirementStatus');
            const submitBtn = document.getElementById('submitBtn');

            if (missingDocs.length > 0) {
                statusDiv.style.display = 'block';
                submitBtn.disabled = true;
                submitBtn.title = 'Please upload all required documents';

                const missingList = document.getElementById('missingDocsList');
                missingList.innerHTML = '<strong>Missing:</strong> ' + missingDocs.join(', ');
            } else {
                statusDiv.style.display = 'none';
                submitBtn.disabled = false;
                submitBtn.title = '';
            }
        }

        form.addEventListener('submit', function (e) {
            const submitBtn = document.getElementById('submitBtn');
            
            if (e.submitter === submitBtn && submitBtn.disabled) {
                e.preventDefault();
                alert('Please upload all required documents before submitting.');
                return false;
            }
        });

        document.getElementById('GovernmentServiceId').addEventListener('change', function () {
            var serviceId = this.value;
            var section = document.getElementById('requirements-section');
            var list = document.getElementById('requirements-list');
            list.innerHTML = '';

            if (!serviceId) {
                section.style.display = 'none';
                document.getElementById('submitBtn').disabled = false;
                return;
            }

            fetch('@Url.Action("GetRequiredDocuments", "ServiceRequest")?serviceId=' + serviceId)
                .then(function (response) {
                    if (!response.ok) throw new Error('Failed to load requirements');
                    return response.json();
                })
                .then(function (data) {
                    requiredDocuments = data;
                    let mandatoryCount = 0;

                    if (data.length === 0) {
                        list.innerHTML = '<li class="list-group-item text-muted">No specific documents required for this service.</li>';
                        document.getElementById('mandatory-count').textContent = '0';
                        document.getElementById('submitBtn').disabled = false;
                    } else {
                        data.forEach(function (doc) {
                            var li = document.createElement('li');
                            li.className = 'list-group-item d-flex justify-content-between align-items-start';

                            if (doc.isMandatory) {
                                mandatoryCount++;
                                var badge = '<span class="badge lb-rejected"><i class="bi bi-exclamation-circle me-1"></i>Required</span>';
                            } else {
                                var badge = '<span class="badge lb-cancelled"><i class="bi bi-check-circle me-1"></i>Optional</span>';
                            }

                            li.innerHTML = '<div><strong>' + doc.documentName + '</strong>'
                                + (doc.description ? '<br/><small class="text-muted">' + doc.description + '</small>' : '')
                                + '</div>' + badge;
                            list.appendChild(li);
                        });

                        document.getElementById('mandatory-count').textContent = mandatoryCount;
                        updateRequirementStatus();
                    }

                    section.style.display = 'block';
                })
                .catch(function () {
                    section.style.display = 'none';
                    document.getElementById('submitBtn').disabled = false;
                });
        });

        // Trigger change event on page load to show requirements for selected service
        document.getElementById('GovernmentServiceId').dispatchEvent(new Event('change'));
    </script>
}
