@model IEnumerable<ServiceRequestDto>
@{
    ViewData["Title"] = "Pending Requests";
    var grouped = Model.GroupBy(r => r.Status);
}

<div class="lb-page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h2><i class="bi bi-hourglass-split me-2"></i>Pending Service Requests</h2>
        <p>Review and process requests awaiting officer or admin action.</p>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <span class="badge bg-danger">@Model.Count() pending</span>
    </div>
</div>

@if (Model.Any())
{
    <!-- Group by status -->
    @foreach (var statusGroup in grouped.OrderBy(g => g.Key.ToString()))
    {
        <div class="mb-4">
            <div class="d-flex align-items-center mb-3">
                <h5 class="mb-0">
                    @if (statusGroup.Key == ServiceRequestStatus.Submitted)
                    {
                        <i class="bi bi-inbox text-primary me-2"></i>
                        <span>Newly Submitted</span>
                    }
                    else if (statusGroup.Key == ServiceRequestStatus.UnderReview)
                    {
                        <i class="bi bi-eye text-warning me-2"></i>
                        <span>Under Review</span>
                    }
                    else
                    {
                        <i class="bi bi-hourglass-split text-info me-2"></i>
                        <span>@statusGroup.Key</span>
                    }
                    <span class="badge ms-2 @(statusGroup.Key == ServiceRequestStatus.Submitted ? "bg-danger" : statusGroup.Key == ServiceRequestStatus.UnderReview ? "bg-warning" : "bg-info")">@statusGroup.Count()</span>
                </h5>
            </div>
            
            <div class="card">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Reference</th>
                                    <th>Service</th>
                                    <th>Citizen</th>
                                    <th>Status</th>
                                    <th>Submitted</th>
                                    <th>Documents</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var request in statusGroup.OrderByDescending(r => r.SubmittedAt))
                                {
                                    <tr>
                                        <td>
                                            <code>@request.ReferenceNumber</code>
                                        </td>
                                        <td>
                                            <strong>@request.GovernmentServiceName</strong>
                                        </td>
                                        <td>
                                            @request.CitizenName
                                        </td>
                                        <td>
                                            @{
                                                var badgeClass = request.Status switch
                                                {
                                                    ServiceRequestStatus.Submitted => "lb-submitted",
                                                    ServiceRequestStatus.UnderReview => "lb-review",
                                                    ServiceRequestStatus.Approved => "lb-approved",
                                                    ServiceRequestStatus.Rejected => "lb-rejected",
                                                    _ => "bg-secondary"
                                                };
                                            }
                                            <span class="badge @badgeClass">@request.Status</span>
                                        </td>
                                        <td>
                                            <small>@(request.SubmittedAt?.ToString("g") ?? "-")</small>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark">Docs</span>
                                        </td>
                                        <td class="text-end">
                                            <div class="btn-group btn-group-sm" role="group">
                                                <a asp-action="Details" asp-route-id="@request.Id" 
                                                   class="btn btn-lb-primary" title="Review and process">
                                                    <i class="bi bi-clipboard-check me-1"></i>Review
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="lb-empty-state">
        <i class="bi bi-check-circle text-success" style="font-size: 3rem;"></i>
        <h4>All Caught Up!</h4>
        <p class="text-muted">There are no pending requests awaiting review.</p>
    </div>
}

@section Scripts {
    <script>
        // Auto-refresh pending requests every 30 seconds
        // Uncomment to enable auto-refresh
        // setInterval(function() {
        //     location.reload();
        // }, 30000);
    </script>
}
