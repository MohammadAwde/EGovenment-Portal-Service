@model IEnumerable<ServiceRequestDto>
@{
    ViewData["Title"] = "Service Requests";
    var draftRequests = Model.Where(r => r.Status == ServiceRequestStatus.Draft);
    var submittedRequests = Model.Where(r => r.Status != ServiceRequestStatus.Draft && r.Status != ServiceRequestStatus.Completed);
    var completedRequests = Model.Where(r => r.Status == ServiceRequestStatus.Completed || r.Status == ServiceRequestStatus.Rejected || r.Status == ServiceRequestStatus.Cancelled);
}

<div class="lb-page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h2><i class="bi bi-file-earmark-text me-2"></i>Service Requests</h2>
        <p>View and manage all your service requests.</p>
    </div>
    @if (User.IsInRole("Citizen"))
    {
        <div class="lb-page-actions">
            <a asp-action="Create" class="btn btn-lb-gold">
                <i class="bi bi-plus-circle me-1"></i>New Request
            </a>
        </div>
    }
</div>

@if (Model.Any())
{
    <!-- Draft Requests Section (Citizen Only) -->
    @if (User.IsInRole("Citizen") && draftRequests.Any())
    {
        <div class="mb-4">
            <div class="d-flex align-items-center mb-3">
                <h5 class="mb-0">
                    <i class="bi bi-file-earmark-text text-warning me-2"></i>Drafts
                    <span class="badge bg-warning">@draftRequests.Count()</span>
                </h5>
            </div>
            <div class="card">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-sm mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Service</th>
                                    <th>Last Modified</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var request in draftRequests)
                                {
                                    <tr>
                                        <td>
                                            <strong>@request.GovernmentServiceName</strong>
                                            <br />
                                            <small class="text-muted"><code>@request.ReferenceNumber</code></small>
                                        </td>
                                        <td>@(request.SubmittedAt?.ToShortDateString() ?? DateTime.Now.ToShortDateString())</td>
                                        <td class="text-end">
                                            <div class="btn-group btn-group-sm" role="group">
                                                <a asp-action="Edit" asp-route-id="@request.Id" class="btn btn-outline-primary" title="Edit">
                                                    <i class="bi bi-pencil me-1"></i>Edit
                                                </a>
                                                <a asp-action="Details" asp-route-id="@request.Id" class="btn btn-outline-secondary" title="View">
                                                    <i class="bi bi-eye me-1"></i>View
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Active Requests Section -->
    @if (submittedRequests.Any())
    {
        <div class="mb-4">
            <div class="d-flex align-items-center mb-3">
                <h5 class="mb-0">
                    <i class="bi bi-hourglass-split text-info me-2"></i>Active Requests
                    <span class="badge bg-info">@submittedRequests.Count()</span>
                </h5>
            </div>
            <div class="card">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Reference</th>
                                    <th>Service</th>
                                    @if (!User.IsInRole("Citizen"))
                                    {
                                        <th>Citizen</th>
                                    }
                                    <th>Status</th>
                                    <th>Submitted</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var request in submittedRequests)
                                {
                                    <tr>
                                        <td><code>@request.ReferenceNumber</code></td>
                                        <td>@request.GovernmentServiceName</td>
                                        @if (!User.IsInRole("Citizen"))
                                        {
                                            <td>@request.CitizenName</td>
                                        }
                                        <td>
                                            @{
                                                var badgeClass = request.Status switch
                                                {
                                                    ServiceRequestStatus.Submitted => "lb-submitted",
                                                    ServiceRequestStatus.UnderReview => "lb-review",
                                                    ServiceRequestStatus.Approved => "lb-approved",
                                                    ServiceRequestStatus.Rejected => "lb-rejected",
                                                    _ => "bg-secondary"
                                                };
                                            }
                                            <span class="badge @badgeClass">@request.Status</span>
                                        </td>
                                        <td>@(request.SubmittedAt?.ToShortDateString() ?? "-")</td>
                                        <td class="text-end">
                                            <a asp-action="Details" asp-route-id="@request.Id" class="btn btn-sm btn-lb-primary">
                                                <i class="bi bi-eye me-1"></i>View
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Completed/Archived Requests Section -->
    @if (completedRequests.Any())
    {
        <div class="mb-4">
            <div class="d-flex align-items-center mb-3">
                <h5 class="mb-0">
                    <i class="bi bi-archive text-secondary me-2"></i>Completed & Archived
                    <span class="badge bg-secondary">@completedRequests.Count()</span>
                </h5>
            </div>
            <div class="card">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-sm mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Reference</th>
                                    <th>Service</th>
                                    @if (!User.IsInRole("Citizen"))
                                    {
                                        <th>Citizen</th>
                                    }
                                    <th>Final Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var request in completedRequests)
                                {
                                    <tr class="text-muted">
                                        <td><code>@request.ReferenceNumber</code></td>
                                        <td>@request.GovernmentServiceName</td>
                                        @if (!User.IsInRole("Citizen"))
                                        {
                                            <td>@request.CitizenName</td>
                                        }
                                        <td>
                                            @{
                                                var badgeClass = request.Status switch
                                                {
                                                    ServiceRequestStatus.Completed => "lb-completed",
                                                    ServiceRequestStatus.Rejected => "lb-rejected",
                                                    ServiceRequestStatus.Cancelled => "lb-cancelled",
                                                    _ => "bg-secondary"
                                                };
                                            }
                                            <span class="badge @badgeClass">@request.Status</span>
                                        </td>
                                        <td class="text-end">
                                            <a asp-action="Details" asp-route-id="@request.Id" class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-eye me-1"></i>View
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="lb-empty-state">
        <i class="bi bi-inbox"></i>
        <h4>No Service Requests</h4>
        <p>You haven't submitted any service requests yet.</p>
        @if (User.IsInRole("Citizen"))
        {
            <a asp-action="Create" class="btn btn-lb-primary mt-3">
                <i class="bi bi-plus-circle me-1"></i>Submit Your First Request
            </a>
        }
    </div>
}
