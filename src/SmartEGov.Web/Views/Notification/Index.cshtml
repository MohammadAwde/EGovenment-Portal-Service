@model IEnumerable<NotificationDto>
@{
    ViewData["Title"] = "Notifications";
}

<div class="lb-page-header">
    <h2><i class="bi bi-bell me-2"></i>Notifications</h2>
    <p>Stay updated with your latest service request activities.</p>
</div>

@if (Model.Any())
{
    <div class="card">
        <div class="card-body p-0">
            @foreach (var n in Model)
            {
                <div class="lb-notification-item @(n.IsRead ? "" : "unread") d-flex justify-content-between align-items-start" data-notification-id="@n.Id">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <i class="bi @(n.IsRead ? "bi-bell" : "bi-bell-fill text-warning")"></i>
                            <strong>@n.Title</strong>
                            @if (!n.IsRead)
                            {
                                <span class="badge lb-submitted">New</span>
                            }
                        </div>
                        <p class="mb-1 text-muted small">@n.Message</p>
                        <small class="text-muted"><i class="bi bi-clock me-1"></i>@n.CreatedAt.ToString("g")</small>
                    </div>
                    @if (!n.IsRead)
                    {
                        <form asp-action="MarkAsRead" method="post" class="flex-shrink-0 ms-3 mark-as-read-form" data-notification-id="@n.Id">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@n.Id" />
                            <button type="submit" class="btn btn-sm btn-lb-primary">
                                <i class="bi bi-check2 me-1"></i>Mark as Read
                            </button>
                        </form>
                    }
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="lb-empty-state">
        <i class="bi bi-bell-slash"></i>
        <p>No notifications yet.</p>
    </div>
}
