@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="lb-error-page">
    <div class="error-icon" style="color:var(--lb-red);">
        <i class="bi bi-exclamation-triangle"></i>
    </div>
    <h2>Something went wrong</h2>
    <p>An error occurred while processing your request. Please try again later or contact support if the problem persists.</p>

    @if (Model.ShowRequestId)
    {
        <div class="lb-form-card d-inline-block mb-3" style="border-left:4px solid var(--lb-red);">
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </div>
    }

    <div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-lb-primary">
            <i class="bi bi-house-door me-1"></i>Go Home
        </a>
    </div>
</div>
