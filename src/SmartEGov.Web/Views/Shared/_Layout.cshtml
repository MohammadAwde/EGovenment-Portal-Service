<!DOCTYPE html>
<html lang="en" id="htmlRoot">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lebanese E-Government Portal</title>
    <script>
        // Apply persisted language direction
        if (localStorage.getItem('smartegov_lang') === 'ar') {
            document.documentElement.dir = 'rtl';
            document.documentElement.lang = 'ar';
        }
        // Apply persisted dark mode early to avoid flash
        try {
            var dark = localStorage.getItem('smartegov:dark');
            if (dark === '1' || (dark === null && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark-theme');
            }
        } catch (e) { /* ignore */ }
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <!-- Local fallback: only include if local file exists to avoid MIME/404 warnings when CDN is blocked -->
    @{
        // Prefer a local copy of bootstrap-icons when available (avoids tracking-prevention CDN blocks).
        // If local copy isn't present, fall back to the CDN.
        try
        {
            var env = Context.RequestServices.GetService(typeof(Microsoft.AspNetCore.Hosting.IWebHostEnvironment)) as Microsoft.AspNetCore.Hosting.IWebHostEnvironment;
            var fileExists = false;
            if (env != null)
            {
                var fi = env.WebRootFileProvider.GetFileInfo("lib/bootstrap-icons/font/bootstrap-icons.min.css");
                fileExists = fi.Exists;
            }
            if (fileExists)
            {
                <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
            }
        }
        catch
        {
            // ignore - don't render local fallback if any error occurs
        }
    }
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var isLoggedIn = User.Identity?.IsAuthenticated ?? false;
        var isAdmin = User.IsInRole("Admin");
        var isOfficer = User.IsInRole("Officer");
        var isCitizen = User.IsInRole("Citizen");
    }

    <!-- Top Bar -->
    <div class="lb-topbar">
        <div class="container-fluid d-flex justify-content-between align-items-center py-1">
            <div class="d-flex align-items-center gap-3 small">
                <span><i class="bi bi-telephone-fill me-1"></i>Hotline: <a href="tel:1700" class="fw-semibold">1700</a></span>
                <span class="d-none d-md-inline">|</span>
                <span class="d-none d-md-inline"><i class="bi bi-envelope-fill me-1"></i><a href="mailto:info@egov.gov.lb">info@egov.gov.lb</a></span>
            </div>
            <div class="d-flex align-items-center gap-2 small">
                <partial name="_LanguageToggle" />
                <!-- Dark mode toggle -->
                <button id="toggleDarkMode" class="btn btn-sm btn-outline-secondary" title="Toggle dark mode" aria-pressed="false" style="display:inline-flex;align-items:center;gap:.35rem;">
                    <i class="bi bi-moon-fill"></i>
                    <span class="d-none d-md-inline">Dark</span>
                </button>
                @if (isLoggedIn)
                {
                    <span>@User.Identity!.Name</span>
                }
            </div>
        </div>
    </div>

    <!-- Main Navbar -->
    <nav class="navbar navbar-expand-lg lb-navbar">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <img src="~/images/cedar.svg" alt="Cedar" style="height:36px;filter:brightness(0) invert(1);" />
                <div>
                    <div class="fw-bold" style="font-size:1rem;line-height:1.1;">SmartEGov</div>
                    <div style="font-size:0.65rem;opacity:0.85;">الحكومة الإلكترونية</div>
                </div>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house me-1"></i>Home
                        </a>
                    </li>

                    @* Citizen links *@
                    @if (isLoggedIn && isCitizen)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Citizen" asp-action="Dashboard">
                                <i class="bi bi-speedometer2 me-1"></i>Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="ServiceRequest" asp-action="Index">
                                <i class="bi bi-file-earmark-text me-1"></i>My Requests
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Appointment" asp-action="Index">
                                <i class="bi bi-calendar-check me-1"></i>My Appointments
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Payment" asp-action="Index">
                                <i class="bi bi-credit-card me-1"></i>My Payments
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Citizen" asp-action="Index">
                                <i class="bi bi-person me-1"></i>Profile
                            </a>
                        </li>
                    }

                    @* Notifications for any logged-in user *@
                    @if (isLoggedIn)
                    {
                        <li class="nav-item">
                            @{
                                /* Use the MVC ViewComponent instead of Blazor component so the
                                   layout does not depend on server-side Blazor or websocket
                                   connectivity. The ViewComponent will render the unread
                                   notification count without requiring Blazor. */
                            }
                            @await Component.InvokeAsync("NotificationBadge")
                        </li>
                    }

                    @if (isLoggedIn && isAdmin)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Index">
                                <i class="bi bi-speedometer2 me-1"></i>Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Appointments">
                                <i class="bi bi-calendar-check me-1"></i>Appointments
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Holidays">
                                <i class="bi bi-calendar-x me-1"></i>Holidays
                            </a>
                        </li>
                    }

                    @if (isLoggedIn && isOfficer)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Officer" asp-action="Dashboard">
                                <i class="bi bi-speedometer2 me-1"></i>Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Officer" asp-action="Signature">
                                <i class="bi bi-vector-pen me-1"></i>My Signature
                            </a>
                        </li>
                    }
                </ul>

                <ul class="navbar-nav mb-2 mb-lg-0">
                    @if (isLoggedIn)
                    {
                        <li class="nav-item">
                            <span class="nav-link text-white opacity-75">
                                <i class="bi bi-person-circle me-1"></i>@User.Identity!.Name
                            </span>
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
    @Html.AntiForgeryToken()
    <button type="submit" class="nav-link btn btn-link p-0 text-white">
        <i class="bi bi-box-arrow-right me-1"></i>Logout
    </button>
</form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Login
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Register">
                                <i class="bi bi-person-plus me-1"></i>Register
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="lb-main-content">
        <div class="container-fluid py-3">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="lb-footer mt-auto">
        <div class="container-fluid py-4">
            <div class="row g-4">
                <div class="col-lg-4">
                    <h6 class="fw-bold text-uppercase mb-3" style="color:var(--lb-gold);">
                        Lebanese E-Government Portal
                    </h6>
                    <p class="small opacity-75">Empowering citizens with fast, transparent, and secure access to government services across Lebanon.</p>
                </div>
                <div class="col-lg-4">
                    <h6 class="fw-bold text-uppercase mb-3" style="color:var(--lb-gold);">Quick Links</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-1"><a asp-controller="Home" asp-action="Index" class="text-white opacity-75 text-decoration-none">Home</a></li>
                        <li class="mb-1"><a asp-controller="Account" asp-action="Register" class="text-white opacity-75 text-decoration-none">Create Account</a></li>
                        <li class="mb-1"><a href="#" class="text-white opacity-75 text-decoration-none">Privacy Policy</a></li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <h6 class="fw-bold text-uppercase mb-3" style="color:var(--lb-gold);">Contact</h6>
                    <ul class="list-unstyled small opacity-75">
                        <li class="mb-1"><i class="bi bi-telephone me-1"></i>Hotline: 1700</li>
                        <li class="mb-1"><i class="bi bi-envelope me-1"></i>info@egov.gov.lb</li>
                        <li class="mb-1"><i class="bi bi-geo-alt me-1"></i>Beirut, Lebanon</li>
                    </ul>
                </div>
            </div>
            <hr class="opacity-25 my-3" />
            <div class="text-center small opacity-75">
                <img src="~/images/cedar.svg" alt="" style="height:20px;filter:brightness(0) invert(1);opacity:0.6;" class="me-2" />
                &copy; @DateTime.Now.Year Lebanese Republic — All Rights Reserved
            </div>
        </div>
    </footer>

    <div id="translationOverlay" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:#1a5c2e;z-index:99999;align-items:center;justify-content:center;flex-direction:column;">
        <img src="/images/cedar.svg" style="height:60px;filter:brightness(0) invert(1);margin-bottom:20px;" />
        <div style="color:white;font-size:18px;font-family:'Cairo',sans-serif;">جاري تحميل الصفحة...</div>
    </div>

    <script>
        if (localStorage.getItem('smartegov_lang') === 'ar') {
            document.getElementById('translationOverlay').style.display = 'flex';
        }
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    <script src="https://unpkg.com/htmx.org@1.9.2" crossorigin="anonymous"></script>
    <script src="~/js/translation.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
